worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    map "$http_origin $scheme://$http_host" $assistant_foreign_origin {
        "~^ " 0;
        "~^(\S+) \1$" 0;
        default 1;
    }

    map "$request_method $content_type" $assistant_not_json {
        "~*^POST application/json\s*(;.*)?$" 0;
        "~^POST " 1;
        default 0;
    }

    limit_req_zone $binary_remote_addr zone=assistant_ollama:10m rate=30r/m;
    limit_req_zone $binary_remote_addr zone=assistant_web_search:10m rate=10r/m;
    limit_req_status 429;

    map $upstream_http_content_security_policy $overleaf_script_nonce {
        "~'nonce-(?<nonce>[^']+)'" $nonce;
        default "";
    }

    server {
        listen 80;
        server_name _;

        client_max_body_size 100m;

        location = /overleaf-ai-assistant.js {
            root /usr/share/nginx/html;
            default_type application/javascript;
            add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        }

        location = /overleaf-ai-assistant/config.json {
            default_type application/json;
            add_header Cache-Control "no-store" always;
            return 200 '{"ollamaEndpoint":"${ASSISTANT_OLLAMA_PATH}","model":"${OLLAMA_MODEL}","agentStepTimeoutMs":${ASSISTANT_STEP_TIMEOUT_MS},"webSearch":{"enabled":${ASSISTANT_WEB_SEARCH_ENABLED},"endpoint":"${ASSISTANT_WEB_SEARCH_PATH}"}}';
        }

        location = /healthz {
            access_log off;
            default_type text/plain;
            return 200 "ok\n";
        }

        location = /healthz/overleaf {
            access_log off;
            proxy_pass http://${OVERLEAF_UPSTREAM}/status;
            proxy_set_header Cookie "";
            proxy_set_header Authorization "";
            proxy_set_header X-Csrf-Token "";
            proxy_hide_header Set-Cookie;
            proxy_connect_timeout 5s;
            proxy_read_timeout 5s;
        }

        location = /healthz/ollama {
            access_log off;
            proxy_pass http://${OLLAMA_UPSTREAM}/api/version;
            proxy_set_header Host $proxy_host;
            proxy_set_header Cookie "";
            proxy_set_header Authorization "";
            proxy_set_header X-Csrf-Token "";
            proxy_hide_header Set-Cookie;
            proxy_connect_timeout 5s;
            proxy_read_timeout 5s;
        }

        location = /overleaf-ai-assistant/session {
            internal;
            proxy_pass http://${OVERLEAF_UPSTREAM}/user/personal_info;
            proxy_method GET;
            proxy_pass_request_body off;
            proxy_pass_request_headers off;
            proxy_set_header Content-Length "";
            proxy_set_header Host $host;
            proxy_set_header Accept application/json;
            proxy_set_header Cookie $http_cookie;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 5s;
            proxy_read_timeout 10s;
        }

        location = ${ASSISTANT_OLLAMA_PATH} {
            if ($assistant_foreign_origin) {
                return 403;
            }
            if ($assistant_not_json) {
                return 415;
            }
            limit_except POST {
                deny all;
            }
            limit_req zone=assistant_ollama burst=30 nodelay;
            auth_request /overleaf-ai-assistant/session;
            proxy_pass http://${OLLAMA_UPSTREAM}/api/generate;
            proxy_http_version 1.1;

            proxy_set_header Host $proxy_host;
            proxy_set_header Cookie "";
            proxy_set_header Authorization "";
            proxy_set_header X-Csrf-Token "";
            proxy_hide_header Set-Cookie;
            proxy_set_header Origin "";
            proxy_set_header Referer "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_buffering off;
            proxy_read_timeout ${OLLAMA_PROXY_TIMEOUT_S}s;
            proxy_send_timeout ${OLLAMA_PROXY_TIMEOUT_S}s;
        }

        location = ${ASSISTANT_WEB_SEARCH_PATH} {
            set $assistant_web_search "${ASSISTANT_WEB_SEARCH}";
            if ($assistant_web_search != on) {
                return 404;
            }
            if ($assistant_foreign_origin) {
                return 403;
            }
            if ($assistant_not_json) {
                return 415;
            }
            limit_except POST {
                deny all;
            }
            limit_req zone=assistant_web_search burst=10 nodelay;
            auth_request /overleaf-ai-assistant/session;
            client_max_body_size 64k;

            proxy_pass https://mcp.exa.ai/mcp;
            proxy_http_version 1.1;
            proxy_ssl_server_name on;
            proxy_ssl_verify on;
            proxy_ssl_verify_depth 3;
            proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

            proxy_set_header Host $proxy_host;
            proxy_set_header Connection "";
            proxy_set_header Cookie "";
            proxy_set_header Authorization "";
            proxy_set_header Origin "";
            proxy_set_header Referer "";
            proxy_set_header X-Csrf-Token "";
            proxy_set_header x-api-key "${ASSISTANT_EXA_API_KEY}";
            proxy_hide_header Set-Cookie;
            proxy_hide_header Strict-Transport-Security;
            proxy_hide_header Access-Control-Allow-Origin;
            proxy_hide_header Access-Control-Allow-Credentials;
            proxy_hide_header Access-Control-Allow-Headers;
            proxy_hide_header Access-Control-Allow-Methods;
            proxy_hide_header Access-Control-Expose-Headers;
            proxy_hide_header Access-Control-Max-Age;

            proxy_buffering off;
            proxy_cache off;
            proxy_connect_timeout 10s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
        }

        location / {
            proxy_pass http://${OVERLEAF_UPSTREAM};
            proxy_http_version 1.1;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Origin "";
            proxy_set_header Referer "";
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Accept-Encoding "";

            proxy_read_timeout 900s;
            proxy_send_timeout 900s;
            proxy_buffering off;

            sub_filter_once off;
            sub_filter '</body>' '<script nonce="$overleaf_script_nonce" src="/overleaf-ai-assistant.js"></script></body>';
        }
    }
}
