{
  "name": "overleaf-ai-assistant",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.core.json",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && vitest run --project unit --project dom --project architecture --project integration --project deploy",
    "test:unit": "vitest run --project unit --project dom",
    "test:architecture": "vitest run --project architecture",
    "test:integration": "npm run build && vitest run --project integration",
    "test:deploy": "npm run build && vitest run --project deploy",
    "test:contract": "vitest run --project contract",
    "test:exa-contract": "vitest run --project exa-contract",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "eventsource-parser": "^4.1.1",
    "marked": "^18.0.14"
  }
}
